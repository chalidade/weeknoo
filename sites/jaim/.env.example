# Optional settings for the AI library (src/lib/ai). Copy to .env — both are
# read at build time, so anything here ends up inside the bundle.

# Where Ollama listens. Only needed when it is not on this machine's default
# port; a site with no .env at all still finds http://localhost:11434.
# VITE_OLLAMA_URL=http://localhost:11434

# Hugging Face key for the hosted fallback — https://huggingface.co/settings/tokens
# WARNING: this is baked into the built site and readable by every visitor.
# Use it for local and preview builds only. On a deployed page, ask the visitor
# for their own key and store it with setHfToken() instead.
# VITE_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
